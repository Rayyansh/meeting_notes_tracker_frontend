# Public config only. Never put secrets or keys in VITE_* variables.
# true  = use the local mock data layer (Phase A)
# false = use the real HTTP client (Phase B, once the API contract is shared)
VITE_USE_MOCK_API=true
# Base URL of the Django REST API (used only when VITE_USE_MOCK_API=false)
VITE_API_BASE_URL=http://localhost:8000/api
# Max transcript upload size in KB (client-side check only; backend must enforce its own limit)
VITE_MAX_UPLOAD_KB=512
